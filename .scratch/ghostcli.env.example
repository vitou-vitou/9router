# GhostCLI (https://ghostcli.dev) — copy to ghostcli.env (gitignored), paste your key, never commit.
# Load it the same way as apinex.env:
#   Get-Content .\ghostcli.env | % { if ($_ -match '^([^=]+)=(.*)$') { Set-Item "Env:$($Matches[1])" $Matches[2] } }

GHOSTCLI_KEY=gcli_paste-your-key
GHOSTCLI_MODEL=claude-opus-5

# Two base-URL conventions, one host. Anthropic clients append /v1/messages themselves,
# so their base is the bare domain; OpenAI/Gemini clients need /v1.
GHOSTCLI_BASE=https://ghostcli.dev
GHOSTCLI_OPENAI_BASE=https://ghostcli.dev/v1
# Point Claude Code at it (docs/quick start):
#   $env:ANTHROPIC_BASE_URL = "https://ghostcli.dev"   # no /v1 -> else 404, misreported as bad model
#   $env:ANTHROPIC_API_KEY  = "gcli_..."

# Catalog is fixed, not dynamic; no /v1/models documented.
#   claude-opus-5, claude-sonnet-5, z-ai/glm-5.3  -> Pro
#   claude-fable-5.1                              -> Max

# 9Router combo testing, same keys as apinex.env.example
ROUTER_BASE=http://localhost:20128
NINEROUTER_KEY=sk-...

# Gotchas before any 401 looks like a bad key:
# - dashboard IP allowlist must include the egress IP of the calling machine (403 otherwise)
# - API access add-on (~$7.90/30d) must be active or every call is 402
# - free plan is capped at 5 messages/day (429), resets in UTC
